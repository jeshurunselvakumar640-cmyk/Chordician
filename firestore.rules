rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 1. Songbook Library
    match /songs/{songId} {
      allow read, write: if true;
    }

    // 2. FCM Push Notification Tokens
    match /fcm_tokens/{tokenId} {
      allow read, write: if true;
    }

    // 3. User Profiles
    match /users/{userId} {
      allow read, write: if true;
    }
  }
}
